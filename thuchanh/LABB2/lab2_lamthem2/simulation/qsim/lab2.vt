// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "10/14/2026 10:44:15"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    block_cuoi
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module block_cuoi_vlg_sample_tst(
	cancel,
	CLK,
	key_valid,
	reset,
	X0,
	X1,
	X2,
	X3,
	sampler_tx
);
input  cancel;
input  CLK;
input  key_valid;
input  reset;
input  X0;
input  X1;
input  X2;
input  X3;
output sampler_tx;

reg sample;
time current_time;
always @(cancel or CLK or key_valid or reset or X0 or X1 or X2 or X3)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module block_cuoi_vlg_check_tst (
	error,
	locked,
	unlocked,
	sampler_rx
);
input  error;
input  locked;
input  unlocked;
input sampler_rx;

reg  error_expected;
reg  locked_expected;
reg  unlocked_expected;

reg  error_prev;
reg  locked_prev;
reg  unlocked_prev;

reg  error_expected_prev;
reg  locked_expected_prev;
reg  unlocked_expected_prev;

reg  last_error_exp;
reg  last_locked_exp;
reg  last_unlocked_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:3] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 3'b1;
end

// update real /o prevs

always @(trigger)
begin
	error_prev = error;
	locked_prev = locked;
	unlocked_prev = unlocked;
end

// update expected /o prevs

always @(trigger)
begin
	error_expected_prev = error_expected;
	locked_expected_prev = locked_expected;
	unlocked_expected_prev = unlocked_expected;
end



// expected error
initial
begin
	error_expected = 1'bX;
	error_expected = #999000 1'b0;
end 

// expected unlocked
initial
begin
	unlocked_expected = 1'bX;
	unlocked_expected = #999000 1'b0;
end 

// expected locked
initial
begin
	locked_expected = 1'bX;
	locked_expected = #999000 1'b0;
end 
// generate trigger
always @(error_expected or error or locked_expected or locked or unlocked_expected or unlocked)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected error = %b | expected locked = %b | expected unlocked = %b | ",error_expected_prev,locked_expected_prev,unlocked_expected_prev);
	$display("| real error = %b | real locked = %b | real unlocked = %b | ",error_prev,locked_prev,unlocked_prev);
`endif
	if (
		( error_expected_prev !== 1'bx ) && ( error_prev !== error_expected_prev )
		&& ((error_expected_prev !== last_error_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port error :: @time = %t",  $realtime);
		$display ("     Expected value = %b", error_expected_prev);
		$display ("     Real value = %b", error_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_error_exp = error_expected_prev;
	end
	if (
		( locked_expected_prev !== 1'bx ) && ( locked_prev !== locked_expected_prev )
		&& ((locked_expected_prev !== last_locked_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port locked :: @time = %t",  $realtime);
		$display ("     Expected value = %b", locked_expected_prev);
		$display ("     Real value = %b", locked_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_locked_exp = locked_expected_prev;
	end
	if (
		( unlocked_expected_prev !== 1'bx ) && ( unlocked_prev !== unlocked_expected_prev )
		&& ((unlocked_expected_prev !== last_unlocked_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port unlocked :: @time = %t",  $realtime);
		$display ("     Expected value = %b", unlocked_expected_prev);
		$display ("     Real value = %b", unlocked_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_unlocked_exp = unlocked_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#2000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

